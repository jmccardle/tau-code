# vsce packages the whole directory unless told otherwise. The extension loads
# a single bundled dist/extension.js plus the webview build, so everything that
# produced them is dead weight in the .vsix.
src/**
node_modules/**
dist-types/**
esbuild.mjs
vite.webview.config.ts
tsconfig.json
tsconfig.tsbuildinfo
**/*.ts
# There is deliberately no `!dist/**` line. vsce applies every negation AFTER
# every ignore, whatever the order in this file, so one here re-included
# dist/extension.js.map and the source map shipped. Nothing excludes dist, so
# the negation was never needed.
**/*.map
