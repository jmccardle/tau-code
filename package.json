{
  "name": "ffwf-tau-code",
  "private": true,
  "version": "0.2.0",
  "description": "Clients for the tau agent harness: a connection server, a web client, and a VS Code extension.",
  "license": "MIT",
  "//workspaces": "Order matters: npm builds workspaces in this order, and packages/server's build copies packages/web/dist-web into itself, so web has to be built first.",
  "workspaces": [
    "packages/protocol",
    "packages/runner",
    "packages/ui",
    "packages/web",
    "packages/server",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-protocol.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "node --test packages/*/test/",
    "smoke": "node scripts/smoke.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:completion": "node scripts/smoke-completion.mjs",
    "check:protocol": "node scripts/generate-protocol.mjs --check",
    "dev:server": "npm run dev --workspace @ffwf/tau-code-server",
    "dev:web": "npm run dev --workspace @ffwf/tau-code-web",
    "clean": "tsc --build --clean && rm -rf packages/*/dist packages/web/dist-web packages/server/dist-web",
    "package": "bash scripts/package.sh",
    "package:vsix": "bash scripts/package.sh vsix",
    "package:image": "bash scripts/package.sh image",
    "publish:extension": "bash scripts/publish-extension.sh",
    "reserve:names": "bash scripts/reserve-names.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
